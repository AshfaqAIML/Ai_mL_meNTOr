{
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/login", "dest": "/frontend/login.html" },
    { "src": "/config-doctor", "dest": "/frontend/config-doctor.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
